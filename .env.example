# CockroachDB Cloud connection string. Never commit the real value.
DATABASE_URL=postgresql://username:password@host:26257/defaultdb?sslmode=verify-full

# Optional local model cache override. The default is .cache/transformers.
EMBEDDING_CACHE_DIR=.cache/transformers

# Anthropic receives only demo work context and retrieved Work States.
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Exact approved Web Demo origin and fixed demo project scope.
CORS_ORIGIN=http://localhost:5173
ALLOWED_PROJECT_IDS=night-portrait,mobile-checkout-redesign
